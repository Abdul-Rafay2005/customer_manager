/* ---------------------------------------------------------------------
   Customer Manager - application stylesheet
   Palette: deep slate navy sidebar, warm neutral content area, single
   accent color used sparingly for primary actions.
--------------------------------------------------------------------- */

* {
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    font-size: 14px;
    color: #1f2430;
}

QMainWindow, QDialog {
    background-color: #f5f6f8;
}

/* ---------------- Sidebar ---------------- */
#Sidebar {
    background-color: #1c2333;
    min-width: 220px;
    max-width: 220px;
}

#SidebarLogo {
    color: #ffffff;
    font-size: 17px;
    font-weight: 600;
    padding: 24px 20px 4px 20px;
}

#SidebarSubtitle {
    color: #8892a6;
    font-size: 12px;
    padding: 0 20px 20px 20px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #c4cadb;
    border: none;
    text-align: left;
    padding: 12px 22px;
    font-size: 14px;
    border-radius: 0px;
}

QPushButton#NavButton:hover {
    background-color: #2a3348;
    color: #ffffff;
}

QPushButton#NavButton:checked {
    background-color: #2f6fed;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#NavButtonLogout {
    background-color: transparent;
    color: #ff8a80;
    border: none;
    text-align: left;
    padding: 12px 22px;
    font-size: 14px;
}
QPushButton#NavButtonLogout:hover {
    background-color: #3a2530;
}

/* ---------------- Cards / content ---------------- */
#ContentArea {
    background-color: #f5f6f8;
}

QFrame[class="Card"] {
    background-color: #ffffff;
    border: 1px solid #e4e7ec;
    border-radius: 10px;
}

QLabel[class="CardTitle"] {
    color: #6b7280;
    font-size: 13px;
    font-weight: 500;
}

QLabel[class="CardValue"] {
    color: #1c2333;
    font-size: 26px;
    font-weight: 700;
}

QLabel[class="PageTitle"] {
    font-size: 22px;
    font-weight: 700;
    color: #1c2333;
}

QLabel[class="SectionSubtitle"] {
    color: #6b7280;
    font-size: 13px;
}

/* ---------------- Menus & popups (incl. calendar month/year picker) ---------------- */
/* Qt's calendar month/year selector and any right-click menus are QMenu
   instances. Without explicit rules they can fall back to the OS's dark
   theme while our global dark text color stays applied on top - making
   text unreadable. Force a readable light background everywhere. */
QMenu {
    background-color: #ffffff;
    color: #1f2430;
    border: 1px solid #d7dae1;
    border-radius: 6px;
}

QMenu::item {
    padding: 6px 24px;
    background-color: transparent;
    color: #1f2430;
}

QMenu::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

/* ---------------- Calendar popup (date pickers) ---------------- */
QCalendarWidget QWidget {
    background-color: #ffffff;
    color: #1f2430;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #ffffff;
    color: #1f2430;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

QCalendarWidget QToolButton {
    background-color: #ffffff;
    color: #1f2430;
    icon-size: 16px;
    border: none;
}

QCalendarWidget QToolButton:hover {
    background-color: #f0f2f5;
    border-radius: 4px;
}

QCalendarWidget QSpinBox {
    background-color: #ffffff;
    color: #1f2430;
}

QCalendarWidget #qt_calendar_navigationbar {
    background-color: #f5f6f8;
}

/* ---------------- Buttons ---------------- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d7dae1;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #f0f2f5;
}

QPushButton#PrimaryButton {
    background-color: #2f6fed;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 6px;
}

QPushButton#PrimaryButton:hover {
    background-color: #2559c7;
}

QPushButton#DangerButton {
    background-color: #e5484d;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 6px;
}
QPushButton#DangerButton:hover {
    background-color: #c53d42;
}

/* ---------------- Inputs ---------------- */
QLineEdit, QComboBox, QDateEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d7dae1;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #2f6fed;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #2f6fed;
}

/* ---------------- Tables ---------------- */
QTableView, QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fafbfc;
    gridline-color: #eef0f3;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    selection-background-color: #dbe7fd;
    selection-color: #1c2333;
}

QHeaderView::section {
    background-color: #f5f6f8;
    color: #4b5563;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e4e7ec;
}

/* ---------------- Login screen ---------------- */
#LoginWindow {
    background-color: #1c2333;
}

#LoginCard {
    background-color: #ffffff;
    border-radius: 14px;
}

#LoginTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1c2333;
}

#LoginSubtitle {
    font-size: 13px;
    color: #6b7280;
}

#LoginError {
    color: #e5484d;
    font-size: 13px;
}
